{
	"name": "theme-image-block",
	"version": "1.1.1",
	"description": "Use images from your theme as blocks in content.",
	"author": "Happy Prime",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"plugin",
		"wordpress"
	],
	"homepage": "https://github.com/happyprime/theme-image-block/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/happyprime/theme-image-block.git"
	},
	"bugs": {
		"url": "https://github.com/happyprime/theme-image-block/"
	},
	"engines": {
		"node": ">=22",
		"npm": ">=10"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-runtime": "^7.29.0",
		"@babel/preset-env": "^7.29.5",
		"@babel/preset-react": "^7.28.5",
		"@happyprime/eslint-config": "^1.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.46.0",
		"@wordpress/env": "^11.6.0",
		"@wordpress/icons": "^13.1.0",
		"@wordpress/npm-package-json-lint-config": "^5.46.0",
		"babel-loader": "^10.1.1",
		"copy-webpack-plugin": "^13.0.1",
		"npm-package-json-lint": "^10.4.0",
		"webpack": "^5.105.2",
		"webpack-cli": "^6.0.1"
	},
	"scripts": {
		"build": "webpack --mode production",
		"start": "webpack --mode development --watch",
		"lint": "npm run lint:js",
		"fix": "eslint ./blocks/src --fix",
		"lint:package": "node ./node_modules/npm-package-json-lint/dist/cli.js ./",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:cli": "wp-env run cli",
		"env:logs": "wp-env logs",
		"lint:js": "eslint ./blocks/src"
	},
	"npmpackagejsonlint": {
		"extends": "@wordpress/npm-package-json-lint-config"
	}
