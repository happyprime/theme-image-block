{
  "name": "theme-image-block",
  "version": "1.1.1",
  "description": "Use images from your theme as blocks in content.",
  "author": "Happy Prime",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "plugin",
    "wordpress"
  ],
  "homepage": "https://github.com/happyprime/theme-image-block/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyprime/theme-image-block.git"
  },
  "bugs": {
    "url": "https://github.com/happyprime/theme-image-block/"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/runtime": "^8.0.5",
    "@happyprime/eslint-config": "^1.0.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.55.0",
    "@wordpress/env": "^11.15.0",
    "@wordpress/icons": "^16.0.0",
    "@wordpress/npm-package-json-lint-config": "^5.55.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "npm-package-json-lint": "^11.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack --mode development --watch",
    "lint": "eslint ./blocks/src",
    "fix": "eslint ./blocks/src --fix",
    "lint:package": "node ./node_modules/npm-package-json-lint/dist/cli.js ./",
    "test:php": "wp-env run cli --config .wp-env.tests.json --env-cwd=wp-content/plugins/theme-image-block vendor/bin/phpunit",
    "env:start": "wp-env start",
    "env:update": "wp-env start --update",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:cli": "wp-env run cli",
    "env:logs": "wp-env logs",
    "env:test:start": "wp-env start --config .wp-env.tests.json",
    "env:test:stop": "wp-env stop --config .wp-env.tests.json",
    "env:test:destroy": "wp-env destroy --config .wp-env.tests.json"
  },
  "npmpackagejsonlint": {
    "extends": "@wordpress/npm-package-json-lint-config"
  }
}
