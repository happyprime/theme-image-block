{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "happyprime/theme-cover",
	"version": "0.1.0",
	"title": "Theme Cover",
	"category": "media",
	"icon": "cover-image",
	"description": "Display a theme image as a cover with an overlay and inner content.",
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": false,
			"__experimentalDuotone": "> .wp-block-happyprime-theme-cover__image-background"
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"html": false
	},
	"attributes": {
		"themeImage": {
			"type": "string",
			"default": ""
		},
		"imageSize": {
			"type": "string",
			"default": "original"
		},
		"altText": {
			"type": "string",
			"default": ""
		},
		"omitAltText": {
			"type": "boolean",
			"default": true
		},
		"overlayColor": {
			"type": "string",
			"default": ""
		},
		"customOverlayColor": {
			"type": "string",
			"default": ""
		},
		"dimRatio": {
			"type": "number",
			"default": 50
		},
		"focalPoint": {
			"type": "object"
		},
		"hasParallax": {
			"type": "boolean",
			"default": false
		},
		"isRepeated": {
			"type": "boolean",
			"default": false
		},
		"minHeight": {
			"type": "number",
			"default": 430
		},
		"minHeightUnit": {
			"type": "string",
			"default": "px"
		},
		"contentPosition": {
			"type": "string",
			"default": "center center"
		},
		"tagName": {
			"type": "string",
			"default": "div"
		}
	},
	"textdomain": "theme-image-block",
	"editorScript": "file:../../build/theme-cover/index.js",
	"style": "file:./style.css"
}
